# shellcheck shell=bash
# ---------------------------------------------------------------------------
# axelera-metis-setup configuration
# Every value can be overridden by exporting it before running the scripts,
# e.g.  SDK_VERSION=1.6.1 EXPECTED_DEVICES=1 ./setup.sh
# or by the matching command-line flag (see ./setup.sh --help).
# ---------------------------------------------------------------------------

# Voyager SDK release to install and the git ref to check out.
# SDK_REF empty = auto-resolve (tries v1.6.1, release/v1.6.1, release/1.6.1, 1.6.1).
SDK_VERSION="${SDK_VERSION:-1.6.1}"
SDK_REF="${SDK_REF:-}"
REPO_URL="${REPO_URL:-https://github.com/axelera-ai-hub/voyager-sdk.git}"
SDK_DIR="${SDK_DIR:-$HOME/voyager-sdk}"

# Number of Metis AIPUs expected on PCIe (4-chip PCIe card = 4).
EXPECTED_DEVICES="${EXPECTED_DEVICES:-4}"

# Flags passed to the SDK's install.sh (an auto-yes flag is added if supported).
INSTALL_FLAGS="${INSTALL_FLAGS:---all --media}"

# Parallel build jobs when rebuilding Python packages that failed
# (onnxoptimizer crashed GCC at -j24). Retries fall back to 2, then 1.
BUILD_JOBS="${BUILD_JOBS:-4}"

# 1 = stop + mask axelera-multi-device.service (it drops PCIe links on MS-7E54).
DISABLE_MULTI_DEVICE="${DISABLE_MULTI_DEVICE:-1}"

# Inference smoke test (paths relative to SDK_DIR).
TEST_MODEL="${TEST_MODEL:-yolov8s-coco-onnx}"
TEST_MEDIA="${TEST_MEDIA:-media/traffic1_1080p.mp4}"
TEST_FRAMES="${TEST_FRAMES:-300}"
PER_DEVICE_FRAMES="${PER_DEVICE_FRAMES:-100}"
# First run compiles/downloads the model, so allow plenty of time (seconds).
INFERENCE_TIMEOUT="${INFERENCE_TIMEOUT:-2400}"

# Preflight thresholds.
MIN_DISK_GB="${MIN_DISK_GB:-40}"
MIN_RAM_GB="${MIN_RAM_GB:-16}"

# Where resume state is kept between runs (survives logout/reboot).
STATE_DIR="${STATE_DIR:-$HOME/.axelera-setup}"
